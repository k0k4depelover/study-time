@echo off
:: ?????????????????????????????????????????????????????????????????????????????
:: build.bat ? Builds StudyTimer.exe using PyInstaller
::
:: Run once on a machine that has Python installed.
:: The resulting dist\StudyTimer.exe works on any Windows PC with no install.
:: ?????????????????????????????????????????????????????????????????????????????

echo.
echo  Building Study Session Timer...
echo.

:: 1. Install PyInstaller if not present
python -m pip install pyinstaller --quiet
if errorlevel 1 (
    echo  ERROR: Python not found. Install Python from https://python.org
    pause
    exit /b 1
)


:: 2. Build single-file executable
python -m PyInstaller ^
    --onefile ^
    --noconsole ^
    --name "StudyTimer" ^
    --add-data "static;static" ^
    --add-data "openapi.json;." ^
    server.py

if errorlevel 1 (
    echo.
    echo  Build FAILED. See errors above.
    pause
    exit /b 1
)

echo.
echo  Done!  dist\StudyTimer.exe is ready.
echo  Copy it anywhere -- no Python needed to run it.
echo  The study.db file will be created next to the .exe.
echo.
pause
